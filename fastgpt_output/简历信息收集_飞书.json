        {
          "key": "system_code",
          "renderTypeList": [
            "textarea"
          ],
          "valueType": "string",
          "label": "",
          "value": "const resumeData = {{$extractResumeInfo.system_result$}};\nconst tokenResponse = {{$getFeishuToken.httpRawResponse$}};\n\n// 从token响应中提取access_token\nlet access_token = '';\ntry {\n  const parsed = JSON.parse(tokenResponse);\n  access_token = parsed.app_access_token || '';\n} catch (e) {\n  console.error('Failed to parse token response:', e);\n}\n\n// 构建飞书多维表格记录\nconst recordData = {\n  fields: {\n    \"姓名\": resumeData.name || '',\n    \"电话\": resumeData.phone || '',\n    \"邮箱\": resumeData.email || '',\n    \"教育背景\": resumeData.education || '',\n    \"工作经历\": resumeData.experience || '',\n    \"技能特长\": resumeData.skills || ''\n  }\n};\n\nconst result = {\n  access_token: access_token,\n  record_data: recordData,\n  json_string: JSON.stringify(recordData)\n};\n\nresult;",
          "valueDesc": "",
          "description": "",
          "debugLabel": "",
          "toolDescription": ""
        },
        {
          "key": "system_outputType",
          "renderTypeList": [
            "hidden"
          ],
          "valueType": "string",
          "label": "",
          "value": "array",
          "valueDesc": "",
          "description": "",
          "debugLabel": "",
          "toolDescription": ""
        },
        {
          "key": "system_variableType",
          "renderTypeList": [
            "hidden"
          ],
          "valueType": "string",
          "label": "",
          "value": "editor",
          "valueDesc": "",
          "description": "",
          "debugLabel": "",
          "toolDescription": ""
