    {
      "nodeId": "extractResumeInfo",
      "name": "提取简历信息",
      "intro": "执行一段简单的脚本代码，通常用于进行复杂的数据处理。",
      "avatar": "core/workflow/template/codeRun",
      "flowNodeType": "code",
      "showStatus": true,
      "position": {
        "x": -250,
        "y": -800
      },
      "version": "481",
      "inputs": [
        {
          "key": "system_text",
          "renderTypeList": [
            "reference",
            "textarea"
          ],
          "valueType": "string",
          "label": "workflow:code_input",
          "value": [
            [
              "workflowStart",
              "userChatInput"
            ]
          ],
          "valueDesc": "",
          "description": "",
          "debugLabel": "",
          "toolDescription": ""
        },
        {
          "key": "system_code",
          "renderTypeList": [
            "textarea"
          ],
          "valueType": "string",
          "label": "",
          "value": "// 提取简历信息的函数\nfunction extractField(text, fieldName) {\n  const regex = new RegExp('\\\\*\\\\*' + fieldName + '\\\\*\\\\*\\\\s*[:：]?\\\\s*([^\\n]+)', 'i');\n  const match = text.match(regex);\n  return match ? match[1].trim() : '';\n}\n\nconst text = '{{系统输入}}';\n\nconst name = extractField(text, '姓名') || '';\nconst phone = extractField(text, '电话') || '';\nconst email = extractField(text, '邮箱') || '';\nconst education = extractField(text, '教育背景') || '';\nconst experience = extractField(text, '工作经历') || '';\nconst skills = extractField(text, '技能特长') || '';\n\nconst result = {\n  name,\n  phone,\n  email,\n  education,\n  experience,\n  skills,\n  fields: [name, phone, email, education, experience, skills]\n};\n\nresult;",
          "valueDesc": "",
          "description": "",
          "debugLabel": "",
          "toolDescription": ""
        },
        {
          "key": "system_outputType",
          "renderTypeList": [
            "hidden"
          ],
          "valueType": "string",
          "label": "",
          "value": "array",
          "valueDesc": "",
          "description": "",
          "debugLabel": "",
          "toolDescription": ""
        },
        {
          "key": "system_variableType",
          "renderTypeList": [
            "hidden"
          ],
          "valueType": "string",
          "label": "",
          "value": "editor",
          "valueDesc": "",
          "description": "",
          "debugLabel": "",
          "toolDescription": ""
        }
